#!/usr/bin/env bash
set -euo pipefail

# Official Linux LTS binary; verify the archive before extracting executable code.
version=4.5.14
archive="blender-${version}-linux-x64.tar.xz"
checksum=9ba871ff2ecd36526b77432745980b7e6664ecd0c7ca11c48849073dcfe06da3
destination="/opt/blender-${version}-linux-x64"
[[ $(uname -m) == x86_64 ]] || { echo 'Blender setup requires Linux x86_64.' >&2; exit 1; }

packages=(ca-certificates curl xz-utils xvfb x11vnc novnc websockify openbox xterm xdotool
  x11-utils x11-xserver-utils mesa-utils libegl1 libgl1 libglu1-mesa libsm6 libxrender1 libxfixes3
  libxi6 libxkbcommon0 libxxf86vm1 libasound2t64)
missing=()
for package in "${packages[@]}"; do
  [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) == 'install ok installed' ]] || missing+=("$package")
done
if (( ${#missing[@]} )); then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

if [[ ! -x "$destination/blender" ]]; then
  download_dir=$(mktemp -d /tmp/astra-blender-install.XXXXXX)
  trap 'rm -r "$download_dir"' EXIT
  curl --fail --location --retry 3 --output "$download_dir/$archive" \
    "https://download.blender.org/release/Blender4.5/$archive"
  (cd "$download_dir" && printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check -)
  tar -xJf "$download_dir/$archive" -C "$download_dir"
  mv "$download_dir/blender-${version}-linux-x64" "$destination"
fi
ln -sfn "$destination/blender" /usr/local/bin/blender
blender --version | head -1
